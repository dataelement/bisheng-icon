{
  "name": "bisheng-icons",
  "version": "0.2.9",
  "description": "Bisheng Design System 图标库 —— 独立可安装的 React 图标组件包",
  "license": "MIT",
  "author": "Dataelement",
  "keywords": [
    "react",
    "icons",
    "icon-library",
    "svg",
    "bisheng",
    "design-system"
  ],
  "homepage": "https://github.com/dataelement/bisheng-icon#readme",
  "bugs": {
    "url": "https://github.com/dataelement/bisheng-icon/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataelement/bisheng-icon.git"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.5.3"
  }
}
